{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/member-query",
      "destination": "https://twktxzhsrobccqmheotf.supabase.co/functions/v1/member-query"
    },
    {
      "source": "/politika",
      "destination": "/politika/index.html"
    },
    {
      "source": "/politika/:path*",
      "destination": "/politika/:path*"
    },
    {
      "source": "/((?!api|politika|assets|icons|images|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}