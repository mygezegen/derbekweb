{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "routes": [
    {
      "src": "/api/member-query",
      "dest": "https://twktxzhsrobccqmheotf.supabase.co/functions/v1/member-query",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/politika/(.*)",
      "dest": "/politika/$1"
    },
    {
      "src": "^/(assets|icons|images)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "^/(.*\\.(html|js|css|png|jpg|jpeg|svg|ico|json|woff|woff2|ttf|webmanifest))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}